{
  // Type-checks the frontend (web/src, TypeScript and Preact TSX) against
  // the Go side's types (web/types/backend.d.ts, generated): make
  // frontend-check runs it.
  "compilerOptions": {
    "noEmit": true,
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["web/types/*.d.ts", "web/src/**/*"]
}
