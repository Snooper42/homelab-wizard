# Homelab settings: the template for .env.
#
# ./homelab creates .env from this file (mode 0600, never committed), fills in
# your Mac's PUID/PGID and timezone, and replaces every __REPLACE_ME__ with a
# generated secret. Copy those secrets into Vaultwarden as
# "homelab - <service> <credential>". Later runs add new keys from this file
# without touching values you already have.
#
# Do not add COMPOSE_PROJECT_NAME or COMPOSE_PROFILES here: every stack reads
# this file, and those would override each stack's own project name.

# --- This Mac -----------------------------------------------------------------
TZ=America/New_York
PUID=501
PGID=20
# Where app ports listen. Keep 127.0.0.1: other devices go through the proxy.
BIND_IP=127.0.0.1
# Where the proxy (80/443) and DNS (53) listen. 0.0.0.0 follows the Mac's
# address, so a new IP (Wi-Fi vs Ethernet) never breaks them.
LAN_BIND_IP=0.0.0.0
# Where AdGuard Home's DNS (53) listens, when not LAN_BIND_IP. Set to this
# machine's address on Linux when systemd-resolved holds 127.0.0.53:53,
# which a 0.0.0.0 bind would collide with.
ADGUARD_DNS_BIND_IP=
# Docker's socket, for the apps that talk to Docker (the socket proxy and
# Beszel's agent). Empty: /var/run/docker.sock. With Docker run as you (SteamOS,
# homelab runtime install), your own: /run/user/<your id>/docker.sock.
DOCKER_SOCKET=
# How the homelab reads the containers, their events, and what they use, and
# runs commands in them (the database copies): auto (the engine's API over
# its socket, found as the docker CLI finds it, with the docker command
# whenever that fails) or off (the docker command only). Starting and
# updating apps is docker compose either way.
DOCKER_API=auto
# How containers reach this machine's own apps (Jellyfin, the phone companion,
# Ollama) as host.docker.internal. Empty: Docker's host-gateway. With Docker run
# as you, this machine's address (host-gateway is then Docker's own namespace).
HOST_GATEWAY=
# Keep this machine from sleeping while it is plugged in, so the apps stay
# reachable (the screen still turns off). false lets it sleep as set.
KEEP_AWAKE=true
# On a laptop running on battery, pause the apps that work hardest in the
# background (downloads, the *arr apps, photo recognition) and start them again
# once it is plugged in; the watchdog checks every 15 minutes. false keeps them.
BATTERY_SAVER=true
# The phone companion (homelab serve, the serve job): Status and Backups on
# paired phones, on port 8099, home network and tailnet only. false: off.
PHONE_COMPANION=true

# --- Storage --------------------------------------------------------------------
# The media drive. Apps that use it wait for it to be mounted.
MEDIA_ROOT=/Volumes/Media
DOWNLOADS_ROOT=/Volumes/Media/downloads
IMMICH_UPLOAD_LOCATION=/Volumes/Media/photos
# Where Duplicati writes encrypted backups: your Proton Drive folder, e.g.
# /Users/you/Library/CloudStorage/ProtonDrive-you@proton.me-folder/homelab-backups
BACKUP_DESTINATION=./backups
# Where Kopia (optional, a second backup beside Duplicati) keeps its
# repository: best another drive than this machine's own, e.g. /Volumes/Backup/kopia.
KOPIA_REPOSITORY=./backups-kopia
# Native Jellyfin's data folder (Jellyfin > Dashboard > Paths shows it).
JELLYFIN_DATA_DIR=~/.local/share/jellyfin
# Syncthing's shared folders (backed up only if you add it to a Duplicati job).
SYNC_ROOT=./data/sync

# small: `up` starts only updates, backups, and alerts (x-homelab-small-baseline
# in compose.yaml), and you pick every other app; folders the desktop app makes
# start this way. Empty or full: every app without a profile, as in this repo.
HOMELAB_BASELINE=

# --- Domain -----------------------------------------------------------------------
# Empty (the default): Home mode, every app at an https address on your tailnet through
# Tailscale, with no domain, AdGuard rewrites, Cloudflare, or tunnel.
HOMELAB_DOMAIN=
# Give each app its https://<name>.<domain> address in Nginx Proxy Manager (and
# the tunnel, for public apps) as soon as it is installed, once Set up the
# domain has run. false: only when you run Set up the domain.
AUTO_DOMAIN=true
# For the wildcard certificate (./homelab domain setup --ssl) and the tunnel's
# public hostnames. Token permissions: Zone.Zone:Read, Zone.DNS:Edit, and
# Account.Cloudflare Tunnel:Edit.
CLOUDFLARE_API_TOKEN=
# From Cloudflare Zero Trust > Networks > Tunnels > your tunnel > Docker.
TUNNEL_TOKEN=

# --- Nginx Proxy Manager and CrowdSec ---------------------------------------------
NPM_VERSION=2.16.0
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443
NPM_ADMIN_PORT=8181
# The account the CLI uses, created on NPM's first start; Let's Encrypt also
# registers certificates with this email. Keep 2FA off for this account (2FA
# blocks the API) and make your personal admin with 2FA instead.
NPM_API_EMAIL=homelab@example.com
NPM_API_PASSWORD=__REPLACE_ME__
CROWDSEC_BOUNCER_KEY=__REPLACE_ME__
# Optional: enrolls CrowdSec in app.crowdsec.net (console > Engines > Add).
CROWDSEC_ENROLL_KEY=

# --- AdGuard Home --------------------------------------------------------------------
ADGUARD_PORT=3003
ADGUARD_SETUP_PORT=3002
# AdGuard's login: homelab adguard setup makes it in the first-run wizard,
# or put in the one you made there. The CLI uses it to add the *.domain rewrite.
ADGUARD_USER=admin
ADGUARD_PASSWORD=

# --- Notifications ---------------------------------------------------------------------
# Alerts also show on this machine's screen (Notification Center on a Mac),
# even before the phone gets them. false: the phone only.
DESKTOP_ALERTS=true
# Who helps you with the homelab: Setup's Email it to my helper writes to them
# with the diagnostics report.
HELPER_EMAIL=
NTFY_PORT=9293
# The publishers' ntfy access token, and the same as a ?auth= parameter for
# publishers that only take a URL. ./homelab notify setup fills both in.
NTFY_PUBLISH_TOKEN=
NTFY_PUBLISH_AUTH=
# A read-only token for the desktop app's list of recent alerts (notify setup).
NTFY_READ_TOKEN=
# The phone's ntfy login (user "phone"), made by notify setup; copy it from Settings.
NTFY_PHONE_PASSWORD=
# An external heartbeat, such as a healthchecks.io check's ping URL (period
# 15 minutes, grace 15 minutes). The watchdog pings it every run and pings
# /fail when something is down, so you hear about it even when this machine,
# its runtime, or ntfy is down.
HEARTBEAT_URL=
# When the background agent runs the nightly updates (4:00 by default). The
# name is from Watchtower, which ran them before.
WATCHTOWER_SCHEDULE=0 0 4 * * *
# The socket proxy holds Docker's socket, so it stays on this version until
# you choose a newer one: read the release notes, change the version, then
# ./homelab update docker-socket-proxy.
SOCKET_PROXY_VERSION=v0.5.0
# Frigate stays on this version until you choose a newer one: read the release
# notes (a new version can change its settings file), then ./homelab update frigate.
FRIGATE_VERSION=0.18.2
# Kopia stays on this version until you choose a newer one: read the release
# notes, then ./homelab update kopia.
KOPIA_VERSION=0.23.1
# Which homelab updates homelab upgrade gets: stable (tagged releases) or
# testing (every change on main, the default until the first release).
UPDATE_CHANNEL=testing
# The largest folder or volume copied before an app's update, so a rollback
# can put it back (500MB, 10GB; 0 copies any size). Databases are always dumped.
UPDATE_COPY_LIMIT=2GB
# The watchdog rolls back an app that stays unhealthy after its nightly
# update, and holds its updates. false: it only alerts.
AUTO_ROLLBACK=true
# The watchdog restarts an app that is unhealthy or not answering on two
# checks in a row (once in 6 hours at most). false: it only alerts.
AUTO_HEAL=true
# The Ollama model that explains logs (Explain this log), e.g. llama3.2.
# Empty: the first Llama, Qwen, Gemma, Mistral, or Phi model Ollama has.
OLLAMA_MODEL=
# Apps whose updates are held after a rollback, or by hand. Written by
# homelab rollback and homelab updates hold|release.
UPDATES_HELD=
# Apps the watchdog checks but does not alert about. Written by
# homelab notify off|on <app> (an app's page › Tell me if it stops).
ALERTS_OFF=

# --- App ports (the installer moves these if something else holds them) ---------------
VAULTWARDEN_PORT=8087
DUPLICATI_PORT=8200
UPTIME_KUMA_PORT=3001
JELLYFIN_PORT=8096
NAVIDROME_PORT=4533
FEISHIN_PORT=9180
AUDIOBOOKSHELF_PORT=13378
CALIBRE_WEB_PORT=8083
KOMGA_PORT=25600
IMMICH_PORT=8013
PAPERLESS_PORT=8010
PAPERLESS_AI_PORT=8011
MONEYMATTER_PORT=13480
FIREFLY_PORT=8094
FIREFLY_IMPORTER_PORT=8097
PROWLARR_PORT=9696
SONARR_PORT=8989
RADARR_PORT=7878
LIDARR_PORT=8686
BAZARR_PORT=6767
TDARR_PORT=8265
SEERR_PORT=5055
LAZYLIBRARIAN_PORT=5299
QBITTORRENT_PORT=8082
FRESHRSS_PORT=8085
MEALIE_PORT=9000
FILEBROWSER_PORT=8086
NEXTCLOUD_PORT=8089
STIRLING_PDF_PORT=8095
KIWIX_PORT=8098
HOMARR_PORT=7575
HOMEPAGE_PORT=3000
KAVITA_PORT=5500
SPEEDTEST_PORT=8765
DOZZLE_PORT=9998
BESZEL_PORT=8090
BESZEL_AGENT_PORT=45876
SYNCTHING_PORT=8384
OPEN_WEBUI_PORT=3080
HOME_ASSISTANT_PORT=8123
FRIGATE_PORT=8971
GROCY_PORT=9283
KARAKEEP_PORT=3010
VIKUNJA_PORT=3456
BAIKAL_PORT=5232
PAIRDROP_PORT=3020
PSITRANSFER_PORT=3030
POCKET_ID_PORT=1411
WALLOS_PORT=8282
CHANGEDETECTION_PORT=5010
MEMOS_PORT=5230
HOMEBOX_PORT=7745
ROMM_PORT=7676
GHOSTFOLIO_PORT=3333
DOCMOST_PORT=3040
DAWARICH_PORT=3050
ACTUAL_PORT=5006
TANDOOR_PORT=8093
LINKWARDEN_PORT=3060
KOPIA_PORT=51515

# --- App settings and secrets --------------------------------------------------------------
# Where Navidrome sees the music folder in its container. Empty: the same
# path as on this machine, so playlists with full paths keep working (Mac and
# Linux). Windows sets /music, since a C:\ path cannot be one there.
NAVIDROME_MUSIC_PATH=
# A Navidrome administrator's login, best one of its own (Navidrome › Users ›
# Create, e.g. homelab, with Is Admin on). With it, Settings › People makes each
# person's Navidrome account and gives them a new password when they need one.
NAVIDROME_ADMIN_USER=
NAVIDROME_ADMIN_PASSWORD=
# A Jellyfin API key (Dashboard › API Keys › +, named Homelab). With it,
# Settings › People makes each person's Jellyfin account (for Infuse and the TV
# apps too) and gives them a new password when they need one.
JELLYFIN_API_KEY=
# Turn on only while creating accounts, then back off (./homelab doctor warns).
VAULTWARDEN_SIGNUPS_ALLOWED=false
DUPLICATI_SETTINGS_KEY=__REPLACE_ME__
DUPLICATI_PASSWORD=__REPLACE_ME__
# The backup jobs' encryption passphrases (homelab duplicati setup uses them).
# Keep DUPLICATI_SECRETS_PASSPHRASE outside this machine too, in Vaultwarden and
# on the recovery kit: it opens the Secrets backup, which holds this file.
DUPLICATI_SECRETS_PASSPHRASE=__REPLACE_ME__
DUPLICATI_PASSPHRASE=__REPLACE_ME__
# Kopia's repository password: it opens every Kopia backup, so keep it outside
# this machine too, with DUPLICATI_SECRETS_PASSPHRASE. The other is its web page's.
KOPIA_PASSWORD=__REPLACE_ME__
KOPIA_SERVER_PASSWORD=__REPLACE_ME__
IMMICH_VERSION=v3
IMMICH_DB_PASSWORD=__REPLACE_ME__
PAPERLESS_DB_PASSWORD=__REPLACE_ME__
# Its PostgreSQL major version; change it only with homelab db upgrade.
PAPERLESS_DB_VERSION=18
PAPERLESS_SECRET_KEY=__REPLACE_ME__
PAPERLESS_OCR_LANGUAGE=eng
# A token made in Paperless-ngx (your account › My Profile › API Auth Token);
# Paperless-AI installs once it is set.
PAPERLESS_AI_PAPERLESS_TOKEN=
PAPERLESS_AI_API_KEY=__REPLACE_ME__
PAPERLESS_AI_JWT_SECRET=__REPLACE_ME__
# The password Frigate and Home Assistant use on Frigate's event broker.
FRIGATE_MQTT_PASSWORD=__REPLACE_ME__
# Nextcloud's administrator (made on its first start) and its database.
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=__REPLACE_ME__
NEXTCLOUD_DB_PASSWORD=__REPLACE_ME__
# Its PostgreSQL major version; change it only with homelab db upgrade.
NEXTCLOUD_DB_VERSION=18
# Nextcloud's major version: the nightly updates bring its fixes; a new major is
# set here (one at a time) after a backup, then ./homelab update nextcloud.
NEXTCLOUD_VERSION=35
VIKUNJA_SECRET=__REPLACE_ME__
# Pocket ID encrypts its keys with this; losing it means re-registering passkeys.
POCKET_ID_ENCRYPTION_KEY=__REPLACE_ME__
# The key homelab sso setup uses on Pocket ID's API to connect the apps.
POCKET_ID_API_KEY=__REPLACE_ME__
# Pocket ID's name, which the apps' containers reach through the proxy here.
# Written by homelab sso setup.
SSO_HOST=
# PsiTransfer: the admin page's password, and the one needed to upload (leave
# the upload one set so only the household can send files).
PSITRANSFER_ADMIN_PASSWORD=__REPLACE_ME__
PSITRANSFER_UPLOAD_PASSWORD=__REPLACE_ME__
# Homebox: turn off once everyone has an account.
HOMEBOX_ALLOW_REGISTRATION=true
# Homebox signs the API keys it gives with this (32 characters or more);
# changing it ends every one of them.
HOMEBOX_API_KEY_PEPPER=__REPLACE_ME__
ROMM_DB_PASSWORD=__REPLACE_ME__
# Its PostgreSQL major version; change it only with homelab db upgrade.
ROMM_DB_VERSION=17
ROMM_AUTH_SECRET_KEY=__REPLACE_ME__
# Optional: artwork and game details for RomM (services/media/RomM.md).
ROMM_IGDB_CLIENT_ID=
ROMM_IGDB_CLIENT_SECRET=
ROMM_SCREENSCRAPER_USER=
ROMM_SCREENSCRAPER_PASSWORD=
GHOSTFOLIO_DB_PASSWORD=__REPLACE_ME__
# Its PostgreSQL major version; change it only with homelab db upgrade.
GHOSTFOLIO_DB_VERSION=17
# Changing either of these later signs everyone out of Ghostfolio for good.
GHOSTFOLIO_ACCESS_TOKEN_SALT=__REPLACE_ME__
GHOSTFOLIO_JWT_SECRET_KEY=__REPLACE_ME__
# Your Ghostfolio security token (the one you sign in with): Finances › Update balances reads the accounts' worth with it, on a click.
GHOSTFOLIO_SECURITY_TOKEN=
DOCMOST_DB_PASSWORD=__REPLACE_ME__
# Its PostgreSQL major version; change it only with homelab db upgrade.
DOCMOST_DB_VERSION=17
# Changing it later signs everyone out of Docmost.
DOCMOST_APP_SECRET=__REPLACE_ME__
DAWARICH_DB_PASSWORD=__REPLACE_ME__
TANDOOR_DB_PASSWORD=__REPLACE_ME__
# Its PostgreSQL major version; change it only with homelab db upgrade.
TANDOOR_DB_VERSION=18
# Changing it later signs everyone out of Tandoor.
TANDOOR_SECRET_KEY=__REPLACE_ME__
# Empty runs MoneyMatter's Intel images under Rosetta. To run the frontend and
# backend natively, build them from source (services/finance/MoneyMatter.md)
# and set homelab/moneymatter-frontend:v0.30.2, homelab/moneymatter-backend:v0.30.2,
# and linux/arm64.
MONEYMATTER_FRONTEND_IMAGE=
MONEYMATTER_BACKEND_IMAGE=
MONEYMATTER_PLATFORM=
MONEYMATTER_DB_PASSWORD=__REPLACE_ME__
# Its PostgreSQL major version; change it only with homelab db upgrade.
MONEYMATTER_DB_VERSION=16
MONEYMATTER_JWT_SECRET=__REPLACE_ME__
MONEYMATTER_SESSION_SECRET=__REPLACE_ME__
MONEYMATTER_AUTH_SECRET=__REPLACE_ME__
# Firefly III encrypts with FIREFLY_APP_KEY (32 characters): keep it with the backup.
FIREFLY_APP_KEY=__REPLACE_ME__
FIREFLY_DB_PASSWORD=__REPLACE_ME__
FIREFLY_DB_VERSION=18
FIREFLY_CRON_TOKEN=__REPLACE_ME__
# A personal access token from Firefly III (Profile › OAuth), for its data importer;
# Finances › Update balances reads the asset accounts' balances with it too, on a click.
FIREFLY_IMPORTER_TOKEN=
# Wallos's API key (Profile › API Key): Finances › Recurring reads its subscriptions with it, on a click.
WALLOS_API_KEY=
HOMARR_SECRET_ENCRYPTION_KEY=__REPLACE_ME__
# Beszel's first account, made on its first start.
BESZEL_EMAIL=homelab@example.com
BESZEL_PASSWORD=__REPLACE_ME__
# The hub's public key, from Beszel's Add System; the agent starts once it is set.
BESZEL_AGENT_KEY=
# Optional qBittorrent VPN (ProtonVPN account > Downloads > WireGuard).
PROTONVPN_WIREGUARD_PRIVATE_KEY=
PROTONVPN_SERVER_COUNTRIES=
# Tailscale: a reusable auth key from login.tailscale.com > Settings > Keys,
# and the home network it makes reachable (set from this machine's network;
# approve the route in the admin).
TAILSCALE_AUTHKEY=
TAILSCALE_ROUTES=192.168.1.0/24
# Extra flags for tailscale up, as --login-server=https://headscale.example.com
# for a tailnet on your own Headscale server. Empty: Tailscale's own.
TAILSCALE_EXTRA_ARGS=
# Home mode (HOMELAB_DOMAIN empty): this machine's tailnet name, written by
# homelab tailnet setup. Every app is at https://<TAILSCALE_HOST>:<its port>.
TAILSCALE_HOST=
# Home mode: false keeps the admin apps (the proxy, AdGuard, Duplicati, Dozzle,
# and the like) off the tailnet, so only this machine opens them; the household
# apps stay on it. true (the default) serves every app.
TAILNET_ADMIN_APPS=true
# The address each app is opened at, for the apps that need to know it (sign-in,
# links in emails). Empty: https://<subdomain>.<domain>. In Home mode homelab
# tailnet setup writes the tailnet address. MoneyMatter only signs in at
# exactly its address.
VAULTWARDEN_URL=
BESZEL_URL=
NTFY_URL=
POCKET_ID_URL=
PAPERLESS_URL=
PAPERLESS_AI_URL=
NEXTCLOUD_URL=
KARAKEEP_URL=
MONEYMATTER_URL=
FIREFLY_URL=
FIREFLY_IMPORTER_URL=
NAVIDROME_URL=
OPEN_WEBUI_URL=
CHANGEDETECTION_URL=
SPEEDTEST_URL=
MEALIE_URL=
VIKUNJA_URL=
DOCMOST_URL=
TANDOOR_URL=
LINKWARDEN_URL=
SPEEDTEST_APP_KEY=__REPLACE_ME__
SPEEDTEST_SCHEDULE=0 */6 * * *
OPEN_WEBUI_SECRET_KEY=__REPLACE_ME__
KARAKEEP_NEXTAUTH_SECRET=__REPLACE_ME__
KARAKEEP_MEILI_MASTER_KEY=__REPLACE_ME__
LINKWARDEN_DB_PASSWORD=__REPLACE_ME__
LINKWARDEN_DB_VERSION=18
LINKWARDEN_NEXTAUTH_SECRET=__REPLACE_ME__
LINKWARDEN_MEILI_MASTER_KEY=__REPLACE_ME__
# Off once the household has its accounts (the first one is the administrator).
LINKWARDEN_DISABLE_REGISTRATION=false
