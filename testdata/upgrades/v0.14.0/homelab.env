# Homelab settings: the template for .env.
#
# ./homelab creates .env from this file (mode 0600, never committed), fills in
# your Mac's PUID/PGID and timezone, and replaces every __REPLACE_ME__ with a
# generated secret. Copy those secrets into Vaultwarden as
# "homelab - <service> <credential>". Later runs add new keys from this file
# without touching values you already have.
#
# Do not add COMPOSE_PROJECT_NAME or COMPOSE_PROFILES here: every stack reads
# this file, and those would override each stack's own project name.

# --- This Mac -----------------------------------------------------------------
PUID=501
PGID=20
# Where app ports listen. Keep 127.0.0.1: other devices go through the proxy.
BIND_IP=127.0.0.1
# Where the proxy (80/443) and DNS (53) listen. 0.0.0.0 follows the Mac's
# address, so a new IP (Wi-Fi vs Ethernet) never breaks them.
LAN_BIND_IP=0.0.0.0
# Where AdGuard Home's DNS (53) listens, when not LAN_BIND_IP. Set to this
# machine's address on Linux when systemd-resolved holds 127.0.0.53:53,
# which a 0.0.0.0 bind would collide with.
ADGUARD_DNS_BIND_IP=
# Docker's socket, for the apps that talk to Docker (Watchtower and the socket
# proxy). Empty: /var/run/docker.sock. With Docker run as you (SteamOS,
# homelab runtime install), your own: /run/user/<your id>/docker.sock.
DOCKER_SOCKET=
# How containers reach this machine's own apps (Jellyfin, the phone companion,
# Ollama) as host.docker.internal. Empty: Docker's host-gateway. With Docker run
# as you, this machine's address (host-gateway is then Docker's own namespace).
HOST_GATEWAY=
# Keep this machine from sleeping while it is plugged in, so the apps stay
# reachable (the screen still turns off). false lets it sleep as set.
KEEP_AWAKE=true
# On a laptop running on battery, pause the apps that work hardest in the
# background (downloads, the *arr apps, photo recognition) and start them again
# once it is plugged in; the watchdog checks every 15 minutes. false keeps them.
BATTERY_SAVER=true
# The phone companion (homelab serve, the serve job): Status and Backups on
# paired phones, on port 8099, home network and tailnet only. false: off.
PHONE_COMPANION=true

# --- Storage --------------------------------------------------------------------
# The media drive. Apps that use it wait for it to be mounted.
MEDIA_ROOT=/home/sam/Media
DOWNLOADS_ROOT=/home/sam/Media/downloads
IMMICH_UPLOAD_LOCATION=/home/sam/Media/photos
# Where Duplicati writes encrypted backups: your Proton Drive folder, e.g.
# /Users/you/Library/CloudStorage/ProtonDrive-you@proton.me-folder/homelab-backups
BACKUP_DESTINATION=./backups
# Where Kopia (optional, a second backup beside Duplicati) keeps its
# repository: best another drive than this machine's own, e.g. /Volumes/Backup/kopia.
KOPIA_REPOSITORY=./backups-kopia
# Native Jellyfin's data folder (Jellyfin > Dashboard > Paths shows it).
JELLYFIN_DATA_DIR=~/.local/share/jellyfin
# Syncthing's shared folders (backed up only if you add it to a Duplicati job).
SYNC_ROOT=./data/sync

# small: `up` starts only updates, backups, and alerts (x-homelab-small-baseline
# in compose.yaml), and you pick every other app; folders the desktop app makes
# start this way. Empty or full: every app without a profile, as in this repo.
HOMELAB_BASELINE=

# --- Domain -----------------------------------------------------------------------
# Empty (the default): Home mode, every app at an https address on your tailnet through
# Tailscale, with no domain, AdGuard rewrites, Cloudflare, or tunnel.
HOMELAB_DOMAIN=
# Give each app its https://<name>.<domain> address in Nginx Proxy Manager (and
# the tunnel, for public apps) as soon as it is installed, once Set up the
# domain has run. false: only when you run Set up the domain.
AUTO_DOMAIN=true
# For the wildcard certificate (./homelab domain setup --ssl) and the tunnel's
# public hostnames. Token permissions: Zone.Zone:Read, Zone.DNS:Edit, and
# Account.Cloudflare Tunnel:Edit.
CLOUDFLARE_API_TOKEN=
# From Cloudflare Zero Trust > Networks > Tunnels > your tunnel > Docker.
TUNNEL_TOKEN=

# --- Nginx Proxy Manager and CrowdSec ---------------------------------------------
NPM_VERSION=2.16.0
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443
NPM_ADMIN_PORT=8181
# The account the CLI uses, created on NPM's first start; Let's Encrypt also
# registers certificates with this email. Keep 2FA off for this account (2FA
# blocks the API) and make your personal admin with 2FA instead.
NPM_API_EMAIL=homelab@example.com
NPM_API_PASSWORD=84XzDCyqe7PM9M3KZEwnzXB2j6mL77ok
CROWDSEC_BOUNCER_KEY=qNWcb9qSsFkmubbcYtqyVriDS4Ye72zJ
# Optional: enrolls CrowdSec in app.crowdsec.net (console > Engines > Add).
CROWDSEC_ENROLL_KEY=

# --- AdGuard Home --------------------------------------------------------------------
ADGUARD_PORT=3003
ADGUARD_SETUP_PORT=3002
# AdGuard's login: homelab adguard setup makes it in the first-run wizard,
# or put in the one you made there. The CLI uses it to add the *.domain rewrite.
ADGUARD_USER=admin
ADGUARD_PASSWORD=

# --- Notifications ---------------------------------------------------------------------
# Alerts also show on this machine's screen (Notification Center on a Mac),
# even before the phone gets them. false: the phone only.
DESKTOP_ALERTS=true
# Who helps you with the homelab: Setup's Email it to my helper writes to them
# with the diagnostics report.
HELPER_EMAIL=
# The publishers' ntfy access token, and the same as a ?auth= parameter for
# publishers that only take a URL. ./homelab notify setup fills both in.
NTFY_PUBLISH_TOKEN=
NTFY_PUBLISH_AUTH=
# A read-only token for the desktop app's list of recent alerts (notify setup).
NTFY_READ_TOKEN=
# The phone's ntfy login (user "phone"), made by notify setup; copy it from Settings.
NTFY_PHONE_PASSWORD=
# An external heartbeat, such as a healthchecks.io check's ping URL (period
# 15 minutes, grace 15 minutes). The watchdog pings it every run and pings
# /fail when something is down, so you hear about it even when this machine,
# its runtime, or ntfy is down.
HEARTBEAT_URL=
WATCHTOWER_SCHEDULE=0 0 4 * * *
# Watchtower and the socket proxy control Docker, so they stay on these
# versions until you choose newer ones: read the release notes, change the
# version, then ./homelab update watchtower (or docker-socket-proxy).
WATCHTOWER_VERSION=1.23.2
SOCKET_PROXY_VERSION=v0.5.0
# Frigate stays on this version until you choose a newer one: read the release
# notes (a new version can change its settings file), then ./homelab update frigate.
FRIGATE_VERSION=0.18.2
# Kopia stays on this version until you choose a newer one: read the release
# notes, then ./homelab update kopia.
KOPIA_VERSION=0.23.1
# Which homelab updates homelab upgrade gets: stable (tagged releases) or
# testing (every change on main, the default until the first release).
UPDATE_CHANNEL=testing
# The largest folder or volume copied before an app's update, so a rollback
# can put it back (500MB, 10GB; 0 copies any size). Databases are always dumped.
UPDATE_COPY_LIMIT=2GB
# The watchdog rolls back an app that stays unhealthy after its nightly
# update, and holds its updates. false: it only alerts.
AUTO_ROLLBACK=true
# The watchdog restarts an app that is unhealthy or not answering on two
# checks in a row (once in 6 hours at most). false: it only alerts.
AUTO_HEAL=true
# The Ollama model that explains logs (Explain this log), e.g. llama3.2.
# Empty: the first Llama, Qwen, Gemma, Mistral, or Phi model Ollama has.
OLLAMA_MODEL=
# Apps whose updates are held after a rollback, and their containers for
# Watchtower. Written by homelab rollback and homelab updates hold|release.
UPDATES_HELD=ntfy
UPDATES_HELD_CONTAINERS=homelab_security-ntfy-1
# Apps the watchdog checks but does not alert about. Written by
# homelab notify off|on <app> (an app's page › Tell me if it stops).
ALERTS_OFF=

